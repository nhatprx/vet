{
  "name": "@nhatprx/vet",
  "version": "1.0.1",
  "description": "Lightweight, zero-dependency engineering ruleset and compliance checker for AI agents and developers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhatprx/vet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "vet": "vet/init.mjs",
    "vet-check": "vet/check.mjs"
  },
  "files": [
    "AGENTS.md",
    "vet.config.json",
    "vet/*.mjs",
    "!vet/*.test.mjs",
    ".githooks/pre-commit",
    ".githooks/commit-msg",
    ".github/workflows/vet.yml"
  ]
}
