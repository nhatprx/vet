{
  "maxLoc": 200,
  "warnLoc": 175,
  "testMaxLoc": 400,
  "maxLineLength": 140,
  "maxStatementsPerLine": 2,
  "banEmoji": true,
  "banTsAny": true,
  "banSecrets": true,
  "banEnvFiles": true,
  "banConflictMarkers": true,
  "banTestOnly": true,
  "banTestSkip": "warn",
  "banDebugger": true,
  "banEmptyCatch": true,
  "banJunkFilenames": true,
  "maxDirDepth": 0,
  "include": ["."],
  "extensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".java",
    ".kt",
    ".py",
    ".go",
    ".rs",
    ".css",
    ".scss",
    ".sql"
  ],
  "docExtensions": [
    ".md",
    ".mdx",
    ".txt"
  ],
  "configExtensions": [
    ".json",
    ".yml",
    ".yaml",
    ".toml",
    ".sh"
  ],
  "ignoreDirs": [
    ".git",
    ".vet",
    "node_modules",
    "dist",
    "build",
    "target",
    "out",
    ".next",
    ".turbo",
    "coverage",
    "__pycache__",
    ".venv",
    "venv"
  ],
  "ignoreFiles": [
    "**/*.generated.*",
    "**/*.d.ts"
  ],
  "customRules": []
}
