#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MSG_SCRIPT="$SCRIPT_DIR/../vet/commit-msg.mjs"

if ! command -v node >/dev/null 2>&1; then
  for dir in \
    /opt/homebrew/bin \
    /usr/local/bin \
    "$HOME/.volta/bin" \
    "$HOME/.fnm/current/bin" \
    "$HOME/.asdf/shims"; do
    if [ -x "$dir/node" ]; then
      PATH="$dir:$PATH"
      break
    fi
  done
fi

if ! command -v node >/dev/null 2>&1 && [ -d "$HOME/.nvm/versions/node" ]; then
  nvm_bin=$(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | tail -n 1 || true)
  if [ -n "$nvm_bin" ] && [ -x "$nvm_bin/node" ]; then
    PATH="$nvm_bin:$PATH"
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  echo "vet commit-msg failed: node is not installed or not in PATH." >&2
  exit 1
fi

node "$MSG_SCRIPT" "$1"
